pipeline {
    agent any
    
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    
    environment {
        LAYER_1_STATUS = "PENDING"
        LAYER_2_STATUS = "PENDING"
        LAYER_3_STATUS = "PENDING"
        LAYER_4_STATUS = "PENDING"
        LAYER_5_STATUS = "PENDING"
        OVERALL_STATUS = "RUNNING"
    }
    
    stages {

        stage('EXECUTE LAYER 1: SETUP') {
            steps {
                script {
                    echo "STARTING LAYER 1"
                    env.LAYER_1_STATUS = "RUNNING"

                    def layer1Build = build job: 'JavaPractice-Layer1',
                                            wait: true,
                                            propagate: false

                    env.LAYER_1_STATUS = layer1Build.result
                }
            }
        }

        stage('EXECUTE LAYER 2: VALIDATION') {
            steps {
                script {
                    echo "STARTING LAYER 2"
                    env.LAYER_2_STATUS = "RUNNING"

                    def layer2Build = build job: 'JavaPractice-Layer2',
                                            wait: true,
                                            propagate: false

                    env.LAYER_2_STATUS = layer2Build.result
                }
            }
        }

        stage('EXECUTE LAYER 3: COMPILATION') {
            steps {
                script {
                    echo "STARTING LAYER 3"
                    env.LAYER_3_STATUS = "RUNNING"

                    def layer3Build = build job: 'JavaPractice-Layer3',
                                            wait: true,
                                            propagate: false

                    env.LAYER_3_STATUS = layer3Build.result
                }
            }
        }

        stage('EXECUTE LAYER 4: TESTING') {
            steps {
                script {
                    echo "STARTING LAYER 4"
                    env.LAYER_4_STATUS = "RUNNING"

                    def layer4Build = build job: 'JavaPractice-Layer4',
                                            wait: true,
                                            propagate: false

                    env.LAYER_4_STATUS = layer4Build.result
                }
            }
        }

        stage('EXECUTE LAYER 5: DEPLOYMENT') {
            steps {
                script {
                    echo "STARTING LAYER 5"
                    env.LAYER_5_STATUS = "RUNNING"

                    def layer5Build = build job: 'JavaPractice-Layer5',
                                            wait: true,
                                            propagate: false

                    env.LAYER_5_STATUS = layer5Build.result
                }
            }
        }

        stage('GENERATE FINAL DASHBOARD') {
            steps {
                script {
                    echo "GENERATING DASHBOARD"

                    if (env.LAYER_1_STATUS == "SUCCESS" &&
                        env.LAYER_2_STATUS == "SUCCESS" &&
                        env.LAYER_3_STATUS == "SUCCESS" &&
                        env.LAYER_4_STATUS == "SUCCESS" &&
                        env.LAYER_5_STATUS == "SUCCESS") {

                        env.OVERALL_STATUS = "ALL 5 LAYERS SUCCESS"

                    } else {
                        env.OVERALL_STATUS = "SOME LAYERS FAILED"
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo """
            ===== MASTER PIPELINE SUMMARY =====
            Layer 1: ${env.LAYER_1_STATUS}
            Layer 2: ${env.LAYER_2_STATUS}
            Layer 3: ${env.LAYER_3_STATUS}
            Layer 4: ${env.LAYER_4_STATUS}
            Layer 5: ${env.LAYER_5_STATUS}
            OVERALL: ${env.OVERALL_STATUS}
            ===================================
            """
        }
    }
}
